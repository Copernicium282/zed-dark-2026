        "ignored.border": "#2a2b2c",
        "info": "#3a94bc",
        "info.background": "#1e3a47",
        "info.border": "#3994bc",
        "modified": "#e5ba7d",
        "modified.background": "#352a05",
        "modified.border": "#b89500",
        "predictive": "#6e7681",
        "renamed": "#3a94bc",
        "renamed.background": "#1e3a47",
        "renamed.border": "#3994bc",
        "success": "#73c991",
        "success.background": "#347d3926",
        "success.border": "#347d39",
        "unreachable": "#8c8c8c",
        "warning": "#e5ba7d",
        "warning.background": "#352a05",
        "warning.border": "#b89500",

        "players": [
          {
            "cursor": "#bbbebf",
            "background": "#3994bc",
            "selection": "#276782dd"
          },
          {
            "cursor": "#57a3f8",
            "background": "#57a3f8",
            "selection": "#57a3f83d"
          },
          {
            "cursor": "#86cf86",
            "background": "#86cf86",
            "selection": "#86cf863d"
          },
          {
            "cursor": "#ad80d7",
            "background": "#ad80d7",
            "selection": "#ad80d73d"
          },
          {
            "cursor": "#cd861a",
            "background": "#cd861a",
            "selection": "#cd861a3d"
          },
          {
            "cursor": "#ef8773",
            "background": "#ef8773",
            "selection": "#ef87733d"
          },
          {
            "cursor": "#e0b97f",
            "background": "#e0b97f",
            "selection": "#e0b97f3d"
          },
          {
            "cursor": "#d670d6",
            "background": "#d670d6",
            "selection": "#d670d63d"
          }
        ],

        "syntax": {
          "attribute": { "color": "#9cdcfe" },
          "boolean": { "color": "#569cd6" },
          "comment": { "color": "#8b949e" },
          "comment.doc": { "color": "#8b949e" },
          "constant": { "color": "#79c0ff" },
          "constructor": { "color": "#4ec9b0" },
          "embedded": { "color": "#bbbebf" },
          "emphasis": { "color": "#c9d1d9", "font_style": "italic" },
          "emphasis.strong": { "color": "#c9d1d9", "font_weight": 700 },
          "enum": { "color": "#79c0ff" },
          "function": { "color": "#d2a8ff" },
          "hint": { "color": "#8c8c8c" },
          "keyword": { "color": "#ff7b72" },
          "keyword.control": { "color": "#c586c0" },
          "keyword.declaration": { "color": "#ff7b72" },
          "keyword.definition": { "color": "#ff7b72" },
          "keyword.import": { "color": "#c586c0" },
          "keyword.operator": { "color": "#569cd6" },
          "label": { "color": "#c8c8c8" },
          "link_text": { "color": "#a5d6ff" },
          "link_uri": { "color": "#48a0c7" },
          "number": { "color": "#b5cea8" },
          "operator": { "color": "#d4d4d4" },
          "predictive": { "color": "#6e7681" },
          "preproc": { "color": "#569cd6" },
          "primary": { "color": "#c9d1d9" },
          "property": { "color": "#c9d1d9" },
          "punctuation": { "color": "#bbbebf" },
          "punctuation.bracket": { "color": "#bbbebf" },
          "punctuation.delimiter": { "color": "#bbbebf" },
          "punctuation.list_marker": { "color": "#ffa657" },
          "punctuation.special": { "color": "#ff7b72" },
          "string": { "color": "#a5d6ff" },
          "string.escape": { "color": "#d7ba7d" },
          "string.regex": { "color": "#a5d6ff" },
          "string.special": { "color": "#a5d6ff" },
          "string.special.symbol": { "color": "#79c0ff" },
          "tag": { "color": "#7ee787" },
          "text.literal": { "color": "#79c0ff" },
          "title": { "color": "#79c0ff", "font_weight": 700 },
          "type": { "color": "#4ec9b0" },
          "variable": { "color": "#c9d1d9" },
          "variable.parameter": { "color": "#ffa657" },
          "variable.special": { "color": "#79c0ff" }
