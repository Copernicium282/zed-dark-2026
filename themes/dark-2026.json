{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dark 2026",
  "author": "Ported from VS Code's 2026 Dark default theme (microsoft/vscode, MIT)",
  "themes": [
    {
      "name": "Dark 2026",
      "appearance": "dark",
      "style": {
        "background": "#191a1b",
        "surface.background": "#191a1b",
        "elevated_surface.background": "#202122",

        "border": "#2a2b2c",
        "border.variant": "#242526",
        "border.focused": "#3994bcb3",
        "border.selected": "#3994bc",
        "border.disabled": "#2a2b2c",
        "border.transparent": "#00000000",

        "element.background": "#242526",
        "element.hover": "#ffffff0d",
        "element.active": "#3994bc33",
        "element.selected": "#3994bc26",
        "element.disabled": "#24252680",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#ffffff0d",
        "ghost_element.active": "#ffffff18",
        "ghost_element.selected": "#3994bc26",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "#3994bc1a",

        "text": "#bfbfbf",
        "text.muted": "#8c8c8c",
        "text.placeholder": "#555555",
        "text.disabled": "#555555",
        "text.accent": "#48a0c7",
        "icon": "#bfbfbf",
